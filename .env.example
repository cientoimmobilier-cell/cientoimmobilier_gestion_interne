# Configuration Flask
FLASK_APP=run.py
FLASK_DEBUG=1
# OBLIGATOIRE : clé secrète stable d'au moins 32 caractères.
# Le démarrage est bloqué si elle est absente (aucune génération automatique).
# Génération : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# Cookies de session / OAuth
# SameSite=Lax est requis pour le callback OAuth Google (Strict le bloque).
SESSION_COOKIE_SAMESITE=Lax
# Secure doit être activé en production (True), désactivé en HTTP local.
SESSION_COOKIE_SECURE=True

# (Optionnel) URI de redirection OAuth Google explicite.
# À définir si l'auto-détection derrière un reverse proxy échoue.
# Exemple : GOOGLE_OAUTH_REDIRECT_URI=https://ciento.example.com/parametres/sauvegarde-cloud/callback
#GOOGLE_OAUTH_REDIRECT_URI=

# Configuration Base de données (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ciento_immobilier_db

# Chemins de stockage
UPLOAD_FOLDER=app/static/uploads
